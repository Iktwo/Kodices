{
  "elements": [
    {
      "type": "row",
      "constants": {
        "text": "Component Catalog",
        "textSecondary": "Demonstrating built-in Piktographs elements"
      }
    },
    {
      "type": "card",
      "constants": {
        "text": "KodicesNavHost & Modals Demo Card",
        "textSecondary": "Trigger server-driven page navigation, dialogs, or bottom sheets",
        "variant": "elevated"
      },
      "nestedElements": [
        {
          "type": "button",
          "constants": {
            "text": "Push Sub-Page",
            "variant": "filled"
          },
          "action": {
            "type": "navigate",
            "constants": {
              "targetRoute": "subpage_demo"
            }
          }
        },
        {
          "type": "container",
          "constants": {
            "spacing": 8
          },
          "nestedElements": [
            {
              "type": "button",
              "constants": {
                "text": "Show Dialog",
                "variant": "outlined",
                "weight": 1.0
              },
              "action": {
                "type": "navigate",
                "constants": {
                  "targetRoute": "dialog_demo",
                  "presentation": "dialog",
                  "title": "SDUI Modal"
                }
              }
            },
            {
              "type": "button",
              "constants": {
                "text": "Show Sheet",
                "variant": "outlined",
                "weight": 1.0
              },
              "action": {
                "type": "navigate",
                "constants": {
                  "targetRoute": "sheet_demo",
                  "presentation": "bottom_sheet"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "card",
      "constants": {
        "text": "New Core UI Primitives",
        "textSecondary": "Switch, Icon, and Horizontal Layout System"
      },
      "nestedElements": [
        {
          "type": "switch",
          "id": "sample_switch",
          "constants": {
            "text": "Enable Push Notifications",
            "textSecondary": "Receive real-time server updates",
            "active": true
          }
        },
        {
          "type": "container",
          "constants": {
            "spacing": 16,
            "alignment": "center"
          },
          "nestedElements": [
            {
              "type": "icon",
              "constants": {
                "name": "settings",
                "size": 28
              }
            },
            {
              "type": "icon",
              "constants": {
                "name": "favorite",
                "size": 28,
                "tint": "#E91E63"
              }
            },
            {
              "type": "icon",
              "constants": {
                "name": "star",
                "size": 28,
                "tint": "#FFC107"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "button",
      "constants": {
        "text": "Filled Button (Message Action)"
      },
      "action": {
        "type": "message",
        "constants": {
          "text": "This is a message from catalog!"
        }
      }
    },
    {
      "type": "progress",
      "constants": {
        "text": "Determinate Linear Progress",
        "textSecondary": "75%",
        "variant": "linear",
        "progress": 0.75
      }
    },
    {
      "type": "progress",
      "constants": {
        "text": "Indeterminate Circular Progress",
        "textSecondary": "Loading...",
        "variant": "circular"
      }
    },
    {
      "type": "textInput",
      "constants": {
        "textSecondary": "Text Input"
      }
    },
    {
      "type": "checkbox",
      "constants": {
        "text": "Active Checkbox",
        "active": true
      }
    },
    {
      "type": "separator",
      "constants": {
        "style": "line",
        "size": 1
      }
    },
    {
      "type": "text",
      "constants": {
        "text": "Dashboard elements",
        "style": "headlineSmall"
      }
    },
    {
      "type": "text",
      "constants": {
        "text": "text takes any Material type scale style, an alignment, a weight and a line limit.",
        "style": "bodyMedium",
        "maxLines": 2
      }
    },
    {
      "type": "grid",
      "constants": {
        "columns": 2
      },
      "nestedElements": [
        {
          "type": "stat",
          "constants": {
            "text": "Living room",
            "value": 21.5,
            "unit": "°C",
            "textSecondary": "2° warmer than yesterday",
            "trend": "up",
            "icon": "home"
          }
        },
        {
          "type": "stat",
          "constants": {
            "text": "Outside",
            "value": 7,
            "unit": "°C",
            "textSecondary": "Light rain",
            "icon": "place"
          }
        }
      ]
    },
    {
      "type": "chart",
      "constants": {
        "text": "Line chart",
        "values": [19.8, 19.4, 19.1, 18.9, 19.0, 19.6, 20.3, 20.9, 21.2, 21.5],
        "labels": ["24 h ago", "now"]
      }
    },
    {
      "type": "chart",
      "constants": {
        "text": "Bar chart",
        "variant": "bar",
        "values": [8.2, 7.4, 9.1, 6.5, 10.2, 12.4, 4.0],
        "labels": ["M", "T", "W", "T", "F", "S", "S"]
      }
    },
    {
      "type": "listItem",
      "constants": {
        "text": "List item",
        "textSecondary": "Leading icon, subtitle and a value at the end",
        "icon": "calendar",
        "value": "09:30"
      },
      "action": {
        "type": "message",
        "constants": {
          "text": "List items are clickable when they have an action."
        }
      }
    },
    {
      "type": "container",
      "constants": {
        "fillMaxWidth": false
      },
      "nestedElements": [
        {
          "type": "badge",
          "constants": {
            "text": "Filled badge"
          }
        },
        {
          "type": "badge",
          "constants": {
            "text": "Outlined badge",
            "variant": "outlined"
          }
        }
      ]
    },
    {
      "type": "text",
      "constants": {
        "text": "Tones, tables and tabs",
        "style": "headlineSmall"
      }
    },
    {
      "type": "text",
      "constants": {
        "text": "A tone (info, success, warning, error) colors a badge, a stat's figure, a list item's icon, a chart or text from the theme.",
        "style": "bodyMedium"
      }
    },
    {
      "type": "container",
      "constants": {
        "fillMaxWidth": false
      },
      "nestedElements": [
        { "type": "badge", "constants": { "text": "Online", "tone": "success", "variant": "tonal" } },
        { "type": "badge", "constants": { "text": "Unproven", "tone": "warning", "variant": "tonal" } },
        { "type": "badge", "constants": { "text": "Failed", "tone": "error" } }
      ]
    },
    {
      "type": "listItem",
      "constants": {
        "text": "A tonal list item is hard to miss",
        "textSecondary": "variant: tonal, tone: warning",
        "icon": "warning",
        "value": "14:02",
        "tone": "warning",
        "variant": "tonal"
      }
    },
    {
      "type": "listItem",
      "constants": {
        "text": "A dense list item",
        "textSecondary": "dense: true, with a badge",
        "icon": "person",
        "badge": "New",
        "tone": "info",
        "value": "12:57",
        "dense": true
      }
    },
    {
      "type": "text",
      "constants": {
        "text": "A grid with minColumnWidth fits as many columns as the width allows: resize the window.",
        "style": "bodyMedium"
      }
    },
    {
      "type": "grid",
      "constants": {
        "minColumnWidth": 120
      },
      "nestedElements": [
        { "type": "stat", "constants": { "text": "Uploads", "value": 321, "size": "medium" } },
        { "type": "stat", "constants": { "text": "Auth failures", "value": 5, "size": "medium", "tone": "warning" } },
        { "type": "stat", "constants": { "text": "Push failures", "value": 2, "size": "medium", "tone": "error" } },
        { "type": "stat", "constants": { "text": "Storage", "value": "48", "unit": "MB", "size": "medium" } }
      ]
    },
    {
      "type": "text",
      "constants": {
        "text": "tableHeader and tableRow share their columns. In a narrow window each row stacks and labels its own values.",
        "style": "bodyMedium"
      }
    },
    {
      "type": "tableHeader",
      "constants": {
        "columns": [
          { "key": "name", "label": "Device", "weight": 2, "secondaryKey": "id" },
          { "key": "status", "label": "Status", "width": 90, "display": "badge", "toneKey": "statusTone" },
          { "key": "group", "label": "Group", "width": 64, "display": "mono" },
          { "key": "sent", "label": "Sent", "width": 56, "align": "end" }
        ]
      }
    },
    {
      "type": "tableRow",
      "constants": {
        "columns": [
          { "key": "name", "label": "Device", "weight": 2, "secondaryKey": "id" },
          { "key": "status", "label": "Status", "width": 90, "display": "badge", "toneKey": "statusTone" },
          { "key": "group", "label": "Group", "width": 64, "display": "mono" },
          { "key": "sent", "label": "Sent", "width": 56, "align": "end" }
        ],
        "values": { "name": "Desk", "id": "77aa01bc", "status": "Online", "statusTone": "success", "group": "a81f", "sent": 40 }
      }
    },
    {
      "type": "tableRow",
      "constants": {
        "columns": [
          { "key": "name", "label": "Device", "weight": 2, "secondaryKey": "id" },
          { "key": "status", "label": "Status", "width": 90, "display": "badge", "toneKey": "statusTone" },
          { "key": "group", "label": "Group", "width": 64, "display": "mono" },
          { "key": "sent", "label": "Sent", "width": 56, "align": "end" }
        ],
        "tone": "warning",
        "values": { "name": "Tablet", "id": "0b9e44d1", "status": "Offline", "group": "a81f", "sent": 0 }
      }
    },
    {
      "type": "card",
      "constants": {
        "text": "Tabs",
        "textSecondary": "As a top-level element of a page they stay above its content; here they are nested to show them in place.",
        "variant": "outlined"
      },
      "nestedElements": [
        {
          "type": "tabs",
          "nestedElements": [
            { "type": "tab", "constants": { "text": "Overview", "icon": "home", "selected": true } },
            { "type": "tab", "constants": { "text": "Devices", "icon": "phone" } },
            { "type": "tab", "constants": { "text": "Logs", "icon": "list" } }
          ]
        }
      ]
    }
  ]
}
