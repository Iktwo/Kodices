{
  "elements": [
    {
      "type": "row",
      "constants": {
        "text": "Component Catalog",
        "textSecondary": "Demonstrating built-in Piktographs elements"
      }
    },
    {
      "type": "card",
      "constants": {
        "text": "KodicesNavHost Demo Card",
        "textSecondary": "Click button below to trigger SDUI page navigation",
        "variant": "elevated"
      },
      "nestedElements": [
        {
          "type": "button",
          "constants": {
            "text": "Navigate to Sub-Page (KodicesNavHost)",
            "variant": "filled"
          },
          "action": {
            "type": "navigate",
            "constants": {
              "targetRoute": "subpage_demo"
            }
          }
        }
      ]
    },
    {
      "type": "button",
      "constants": {
        "text": "Filled Button (Message Action)"
      },
      "action": {
        "type": "message",
        "constants": {
          "text": "This is a message from catalog!"
        }
      }
    },
    {
      "type": "button",
      "constants": {
        "text": "Outlined Button",
        "variant": "outlined"
      }
    },
    {
      "type": "button",
      "constants": {
        "text": "Disabled Button",
        "enabled": false
      }
    },
    {
      "type": "progress",
      "constants": {
        "text": "Determinate Linear Progress",
        "textSecondary": "75%",
        "variant": "linear",
        "progress": 0.75
      }
    },
    {
      "type": "progress",
      "constants": {
        "text": "Indeterminate Circular Progress",
        "textSecondary": "Loading...",
        "variant": "circular"
      }
    },
    {
      "type": "textInput",
      "constants": {
        "textSecondary": "Text Input"
      }
    },
    {
      "type": "checkbox",
      "constants": {
        "text": "Active Checkbox",
        "active": true
      }
    }
  ]
}
