{
  "elements": [
    {
      "type": "row",
      "constants": {
        "text": "Component Catalog",
        "textSecondary": "Demonstrating built-in Piktographs elements"
      }
    },
    {
      "type": "card",
      "constants": {
        "text": "KodicesNavHost & Modals Demo Card",
        "textSecondary": "Trigger server-driven page navigation, dialogs, or bottom sheets",
        "variant": "elevated"
      },
      "nestedElements": [
        {
          "type": "button",
          "constants": {
            "text": "Push Sub-Page",
            "variant": "filled"
          },
          "action": {
            "type": "navigate",
            "constants": {
              "targetRoute": "subpage_demo"
            }
          }
        },
        {
          "type": "hrow",
          "constants": {
            "spacing": 8
          },
          "nestedElements": [
            {
              "type": "button",
              "constants": {
                "text": "Show Dialog",
                "variant": "outlined",
                "weight": 1.0
              },
              "action": {
                "type": "navigate",
                "constants": {
                  "targetRoute": "dialog_demo",
                  "presentation": "dialog",
                  "title": "SDUI Modal"
                }
              }
            },
            {
              "type": "button",
              "constants": {
                "text": "Show Sheet",
                "variant": "outlined",
                "weight": 1.0
              },
              "action": {
                "type": "navigate",
                "constants": {
                  "targetRoute": "sheet_demo",
                  "presentation": "bottom_sheet"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "card",
      "constants": {
        "text": "New Core UI Primitives",
        "textSecondary": "Switch, Icon, and Horizontal Layout System"
      },
      "nestedElements": [
        {
          "type": "switch",
          "id": "sample_switch",
          "constants": {
            "text": "Enable Push Notifications",
            "textSecondary": "Receive real-time server updates",
            "active": true
          }
        },
        {
          "type": "hrow",
          "constants": {
            "spacing": 16,
            "alignment": "center"
          },
          "nestedElements": [
            {
              "type": "icon",
              "constants": {
                "name": "settings",
                "size": 28
              }
            },
            {
              "type": "icon",
              "constants": {
                "name": "favorite",
                "size": 28,
                "tint": "#E91E63"
              }
            },
            {
              "type": "icon",
              "constants": {
                "name": "star",
                "size": 28,
                "tint": "#FFC107"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "button",
      "constants": {
        "text": "Filled Button (Message Action)"
      },
      "action": {
        "type": "message",
        "constants": {
          "text": "This is a message from catalog!"
        }
      }
    },
    {
      "type": "progress",
      "constants": {
        "text": "Determinate Linear Progress",
        "textSecondary": "75%",
        "variant": "linear",
        "progress": 0.75
      }
    },
    {
      "type": "progress",
      "constants": {
        "text": "Indeterminate Circular Progress",
        "textSecondary": "Loading...",
        "variant": "circular"
      }
    },
    {
      "type": "textInput",
      "constants": {
        "textSecondary": "Text Input"
      }
    },
    {
      "type": "checkbox",
      "constants": {
        "text": "Active Checkbox",
        "active": true
      }
    }
  ]
}
